1. Find the length of "Tum Hi Ho" using strlen()
#include <stdio.h>
#include <string.h>

int main() {
    char songTitle[] = "Tum Hi Ho";

    printf("Song: %s\n", songTitle);
    printf("Length: %zu\n", strlen(songTitle));

    return 0;
}

-----------------
Output:
Song: Tum Hi Ho
Length: 9

