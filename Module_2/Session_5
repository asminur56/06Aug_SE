2. Zomato-Style Food Suggestion — switch-case
#include <stdio.h>
#include <string.h>

int main() 
{
    char meal[20];

    printf("Enter meal time (breakfast/lunch/dinner/snack): ");
    scanf("%19s", meal);

    if (strcmp(meal, "breakfast") == 0)
        printf("Suggestion: Masala Dosa!\n");
    else if (strcmp(meal, "lunch") == 0)
        printf("Suggestion: Biryani!\n");
    else if (strcmp(meal, "dinner") == 0)
        printf("Suggestion: Paneer Butter Masala with Naan!\n");
    else if (strcmp(meal, "snack") == 0)
        printf("Suggestion: Samosa!\n");
    else
        printf("Try some fruits!\n");
    return 0;
}


