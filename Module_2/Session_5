1. IPL Fan Bot 
#include <stdio.h>
#include <string.h>

int main()
{
    char team[50];

    printf("Enter your favorite IPL team: ");
    scanf("%49s", team);

    if (strcmp(team, "Mumbai") == 0) {
        printf("Go Mumbai Indians!\n");
    }
    else if (strcmp(team, "Chennai") == 0) {
        printf("Chennai Super Kings for the win!\n");
    }
    else if (strcmp(team, "Bangalore") == 0) {
        printf("RCB, Ee Sala Cup Namde!\n");
    }
    else if (strcmp(team, "Kolkata") == 0) {
        printf("Go Kolkata Knight Riders!\n");
    }
    else if (strcmp(team, "Delhi") == 0) {
        printf("Go Delhi Capitals!\n");
    else {
        printf("Team not found!\n");
    }

    return 0;
}


