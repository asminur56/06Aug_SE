4. formatPrice() — Format rupee prices:-
#include <stdio.h>

void formatPrice(int price, char result[]) {
    if (price >= 1000) {
        sprintf(result, "₹%d,%03d", price / 1000, price % 1000);
    } else {
        sprintf(result, "₹%d", price);
    }
}

int main() {
    char price1[50], price2[50], price3[50];

    formatPrice(1599, price1);
    formatPrice(24999, price2);
    formatPrice(799, price3);

    printf("Laptop: %s\n", price1);
    printf("Headphones: %s\n", price2);
    printf("Mouse: %s\n", price3);

    return 0;
}

