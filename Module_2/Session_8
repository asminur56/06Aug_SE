1. getUserInitials() — Get initials in uppercase:-

#include <stdio.h>
#include <ctype.h>

void getUserInitials(char name[], char initials[]) {
    int i = 0, j = 0;

    // First letter
    while (name[i] == ' ')
        i++;

    initials[j++] = toupper(name[i]);

    // Find the first letter after a space
    while (name[i] != '\0') {
        if (name[i] == ' ' && name[i + 1] != '\0') {
            initials[j++] = toupper(name[i + 1]);
            break;
        }
        i++;
    }

    initials[j] = '\0';
}

int main() {
    char name[] = "Virat Kohli";
    char initials[10];

    getUserInitials(name, initials);

    printf("Initials: %s\n", initials);

    return 0;
}

