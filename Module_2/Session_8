void capitalizeFirst(char str[]) {
    if (str[0] != '\0') {
        str[0] = toupper(str[0]);
    }
}

int main() {
    char product[] = "laptop";
    char username[] = "virat";
    char city[] = "mumbai";

    capitalizeFirst(product);
    capitalizeFirst(username);
    capitalizeFirst(city);

