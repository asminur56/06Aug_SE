2. Read playlist.txt using r
#include <stdio.h>

int main() {
    FILE *file;
    char song[100];

    file = fopen("playlist.txt", "r");

    if (file == NULL) {
        printf("Unable to open file.\n");
        return 1;
    }

    printf("Songs in playlist:\n");

    while (fgets(song, sizeof(song), file) != NULL) {
        printf("%s", song);
    }

    fclose(file);

    return 0;
}

