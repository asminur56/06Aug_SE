1. Create playlist.txt and write 3 songs using w
#include <stdio.h>

int main() {
    FILE *file;

    file = fopen("playlist.txt", "w");

    if (file == NULL) {
        printf("Unable to create file.\n");
        return 1;
    }

    fprintf(file, "Perfect\n");
    fprintf(file, "Shape of You\n");
    fprintf(file, "Love Story\n");

    fclose(file);

    printf("3 songs written to playlist.txt successfully.\n");

    return 0;
}

