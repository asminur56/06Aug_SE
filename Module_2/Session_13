4. Print only songs containing "love" — case-insensitive
#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main() {
    FILE *file;
    char song[100];
    char lowerSong[100];

    file = fopen("playlist.txt", "r");

    if (file == NULL) {
        printf("Unable to open file.\n");
        return 1;
    }

    printf("Songs containing 'love':\n");

    while (fgets(song, sizeof(song), file) != NULL) {

        // Convert song name to lowercase
        for (int i = 0; song[i] != '\0'; i++) {
            lowerSong[i] = tolower((unsigned char)song[i]);
        }
        lowerSong[strlen(song)] = '\0';

        // Search for "love"
        if (strstr(lowerSong, "love") != NULL) {
            printf("%s", song);
        }
    }

    fclose(file);

    return 0;
}
