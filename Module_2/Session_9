1. 1D Array — Daily Steps
#include <stdio.h>

int main() {
    int dailySteps[7] = {5000, 7200, 6500, 8000, 9000, 7500, 10000};

    for (int i = 0; i < 7; i++) {
        printf("Day %d: %d steps\n", i + 1, dailySteps[i]);
    }

    return 0;
}
----------------------------
Output:
Day 1: 5000 steps
Day 2: 7200 steps
Day 3: 6500 steps
Day 4: 8000 steps
Day 5: 9000 steps
Day 6: 7500 steps
Day 7: 10000 steps

