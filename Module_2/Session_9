4. Highest Score From Each IPL Match
#include <stdio.h>

int main() {
    int cricketScores[4][2] = {
        {185, 172},
        {160, 175},
        {210, 198},
        {145, 150}
    };

    for (int i = 0; i < 4; i++) {
        int highest;

        if (cricketScores[i][0] > cricketScores[i][1])
            highest = cricketScores[i][0];
        else
            highest = cricketScores[i][1];

        printf("Match %d highest score: %d\n", i + 1, highest);
    }

    return 0;
}

---------------------------
Output:
Match 1 highest score: 185
Match 2 highest score: 175
Match 3 highest score: 210
Match 4 highest score: 150
