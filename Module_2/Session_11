3. Array traversal using a pointer
#include <stdio.h>

int main() {
    int orders[5] = {250, 450, 120, 600, 300};
    int *ptr = orders;

    for (int i = 0; i < 5; i++) {
        printf("Order amount = %d, Address = %p\n",
               *(ptr + i), (void *)(ptr + i));
    }

    return 0;
}

