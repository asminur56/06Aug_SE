1. likes and ptrLikes
#include <stdio.h>

int main() {
    int likes = 500;
    int *ptrLikes = &likes;

    printf("Likes value = %d\n", likes);
    printf("Address stored in ptrLikes = %p\n", (void *)ptrLikes);

    return 0;
}

