#include <stdio.h>
#include <string.h>
#include <stdlib.h>
#include <time.h>

int main() {
    char songs[3][50] = {
        "Believer",
        "Perfect",
        "Shape of You"
    };

    char guess[50];
    int randomIndex;

    srand(time(NULL));

    randomIndex = rand() % 3;

    printf("Guess the Song Game \n");
    printf("Guess the randomly selected song!\n");

    do {
        printf("Enter your guess: ");
        scanf(" %[^\n]", guess);

        if (strcmp(guess, songs[randomIndex]) == 0) {
            printf("Correct! You guessed the song! \n");
        }
        else {
            printf("Wrong guess! Try again.\n");
        }

    } while (strcmp(guess, songs[randomIndex]) != 0);

    return 0;
}


