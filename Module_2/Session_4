2. Flipkart-Style Discount Calculator

#include <stdio.h>

float calculateFinalPrice(float price, float discount, int isMember) 
{
    float finalPrice;

    finalPrice = price - (price * discount / 100);

    if (isMember)
{
        finalPrice = finalPrice - (finalPrice * 5 / 100);
    }

    return finalPrice;
}

int main() 
{
    printf("Final Price = %.2f\n",
           calculateFinalPrice(1000, 20, 1));
    return 0;
}


